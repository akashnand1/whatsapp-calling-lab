# ===========================================================================
# Meta / WhatsApp
# ===========================================================================
# YOU fill these in on your own machine. Never paste them into chat, a ticket,
# or a shared doc -- WA_ACCESS_TOKEN can send messages and place billable calls
# as your business.
#
# App Dashboard -> your app -> WhatsApp -> API Setup
WA_ACCESS_TOKEN=

# The phone number *ID*, not the phone number. Same API Setup page.
WA_PHONE_NUMBER_ID=

# WhatsApp Business Account ID. Only needed to create templates.
WA_BUSINESS_ACCOUNT_ID=

# Pin the version so Meta cannot change behaviour under you.
WA_GRAPH_VERSION=v26.0

# Any random string you invent. Enter the SAME value in App Dashboard when
# configuring the webhook; Meta echoes it back during verification.
WA_WEBHOOK_VERIFY_TOKEN=

# App Secret -- lets us verify X-Hub-Signature-256 so we know webhooks really
# came from Meta. Strongly recommended once you are past first light.
WA_APP_SECRET=

# ===========================================================================
# Media / networking
# ===========================================================================
# Meta's VoIP stack is ICE-LITE: it publishes candidates and waits. It will NOT
# help traverse NAT. One of the following must be true or your calls will
# connect at the signalling layer and then sit in total silence.
#
#   Option A (best): this host has a public IP. Set it here.
#                    aiortc only sees the private address on a NAT'd cloud VM.
PUBLIC_IP=

#   Option B (FASTEST for testing, no signup): free relay with static auth.
#             Credentials are derived locally from a published shared secret via
#             the TURN REST scheme, so there is no account or API key.
#             Caveat: all call audio relays through the operator, and it adds
#             latency. Do not leave this in place for production.
TURN_STATIC_AUTH=staticauth.openrelay.metered.ca,openrelayprojectsecret

# aiortc honours exactly ONE TURN URL and silently discards any others, so this
# is the only transport that will ever be tried — not a preference order.
# tcp443 is the default because it survives networks that filter UDP.
# Options: tcp443 | tcp80 | udp443 | udp80 | udp3478
# Run `python cli.py turn-test` to find which one works on your network.
TURN_TRANSPORT=tcp443

#   Option C: your own coturn. Format: urls,user,credential  (';' separates several)
TURN_SERVER=

#   Option C: a public STUN server. Leave EMPTY unless you need it -- it is a
#             third-party dependency that learns your media IP on every call.
STUN_SERVER=

# Note: an HTTPS tunnel (ngrok etc.) forwards TCP only. It does nothing for UDP
# media. It is fine for webhooks, useless for audio.

# ===========================================================================
# AI pipeline -- provider selection
# ===========================================================================
# Set to 1 to run with NO AI at all: media only, so you can prove ICE/DTLS work
# before adding any external dependency. Start here.
MEDIA_ONLY=1

# --- Speech to text ---
#   deepgram      cloud. Best endpointing. Caller AUDIO leaves your network.
#   whisper_local self-hosted faster-whisper. Nothing leaves. Slower endpointing.
STT_PROVIDER=whisper_local
DEEPGRAM_API_KEY=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# --- Language model ---
#   anthropic          Anthropic API. Transcript text leaves your network.
#   bedrock            Claude via YOUR AWS account, in a region you choose.
#   openai_compatible  your own vLLM / Ollama / TGI. Nothing leaves.
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# for LLM_PROVIDER=bedrock
AWS_REGION=
BEDROCK_MODEL_ID=

# for LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=
LLM_API_KEY=

# --- Text to speech ---
#   elevenlabs   cloud. Best quality. The agent's SCRIPT leaves your network.
#   piper_local  self-hosted. Nothing leaves. Lower quality but intelligible.
TTS_PROVIDER=piper_local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
PIPER_BIN=piper
PIPER_MODEL=
PIPER_RATE=22050
